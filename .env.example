# ── Plaid (optional second provider) ──────────────────────────────────────
# Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# sandbox = free, fake test banks. production = real banks, costs money per
# the pay-as-you-go pricing on your Plaid dashboard.
PLAID_ENV=sandbox

# Required to connect UK Open Banking institutions (Coutts, NatWest, RBS, and
# most GB banks) — they only support Plaid Link's OAuth flow. Must exactly
# match a URI registered in the Plaid Dashboard under Team Settings > API >
# Allowed redirect URIs.
PLAID_REDIRECT_URI=https://localhost:3000/plaid/oauth-callback

# ── TrueLayer ──────────────────────────────────────────────────────────────
# Get these from https://console.truelayer.com (Sandbox environment)
TRUELAYER_CLIENT_ID=your_client_id_here
TRUELAYER_CLIENT_SECRET=your_client_secret_here
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com
TRUELAYER_API_URL=https://api.truelayer-sandbox.com
REDIRECT_URI=https://localhost:3000/auth/callback

# Your app's URL (must match the redirect URI registered with each provider)
APP_URL=https://localhost:3000

# Session secret - generate with `openssl rand -hex 32`, never reuse across environments
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Encrypts stored bank tokens/transactions at rest (server/crypto.js).
# Generate with `openssl rand -hex 32` - must be exactly 32 bytes (64 hex chars).
ENCRYPTION_KEY=change-this-to-a-random-32-byte-hex-key

# Set to "production" when deployed, so session cookies require HTTPS
NODE_ENV=development

PORT=3000

# Per-colleague login accounts are managed separately, not via .env - see:
#   node scripts/manage-users.js add <email> <password>
