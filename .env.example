# ── Starling Bank ──────────────────────────────────────────────────────────
# Generate a Personal Access Token at https://developer.starlingbank.com
# (Personal Access page → scan the QR code with the Starling app → tick
# account:read + balance:read + transaction:read). Free, no OAuth needed —
# it only ever grants access to your own account.
STARLING_API_URL=https://api.starlingbank.com
STARLING_PERSONAL_ACCESS_TOKEN=

# ── Enable Banking (all other UK banks) ───────────────────────────────────
# Register an application at https://enablebanking.com/cp/applications
# Free "Restricted Production" tier covers accounts you link yourself.
# Registering downloads a private key file — point to it below.
ENABLEBANKING_API_URL=https://api.enablebanking.com
ENABLEBANKING_APP_ID=your_application_id_here
ENABLEBANKING_PRIVATE_KEY_PATH=./certs/enablebanking-private-key.pem

# Your app's URL (must match the redirect URI registered with Enable Banking)
APP_URL=https://localhost:3000

# Session secret - change this to a long random string in production
SESSION_SECRET=change-this-to-a-random-secret-in-production

PORT=3000
