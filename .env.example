# ── Plaid (optional second provider) ──────────────────────────────────────
# Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# sandbox = free, fake test banks. production = real banks, costs money per
# the pay-as-you-go pricing on your Plaid dashboard.
PLAID_ENV=sandbox

# ── TrueLayer ──────────────────────────────────────────────────────────────
# Get these from https://console.truelayer.com (Sandbox environment)
TRUELAYER_CLIENT_ID=your_client_id_here
TRUELAYER_CLIENT_SECRET=your_client_secret_here
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com
TRUELAYER_API_URL=https://api.truelayer-sandbox.com
REDIRECT_URI=https://localhost:3000/auth/callback

# Your app's URL (must match the redirect URI registered with each provider)
APP_URL=https://localhost:3000

# Session secret - change this to a long random string in production
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Shared password everyone (colleagues) uses to log into the dashboard
DASHBOARD_PASSWORD=pick-a-real-password-here

PORT=3000
