# TrueLayer API Credentials
# Get these from https://console.truelayer.com
TRUELAYER_CLIENT_ID=your_client_id_here
TRUELAYER_CLIENT_SECRET=your_client_secret_here

# App settings
# Use https://auth.truelayer-sandbox.com for sandbox (testing)
# Use https://auth.truelayer.com for production
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com
TRUELAYER_API_URL=https://api.truelayer-sandbox.com

# Your app's URL (must match redirect URI in TrueLayer console)
APP_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/auth/callback

# Session secret - change this to a long random string in production
SESSION_SECRET=change-this-to-a-random-secret-in-production

PORT=3000
